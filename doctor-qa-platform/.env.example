# ========================================
# 医学知识问答平台 环境配置
# ========================================
# 使用说明：复制此文件为 .env 并修改配置值

# 服务端口
PORT=3009

# ========================================
# RAG 知识库数据库连接
# ========================================
# 格式：user:password@host:port/database
# 与 agent-qc-node 共用同一个 RAG 数据库实例（只读访问）
RAG_DB_CONN_STR=postgres:postgres@localhost:5433/rag

# ========================================
# Embedding 向量化配置（可选）
# ========================================
# 如不配置，系统自动降级为纯关键词搜索 + LLM 回答
# DeepSeek 不提供 Embedding API，如需向量搜索可配硅基流动：
# EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
# EMBEDDING_API_KEY=your_siliconflow_api_key
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ========================================
# LLM 大模型配置（用于生成回答）
# ========================================
# 使用 DeepSeek（推荐）
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-v4-flash
# 强模型：复杂问题/多源综合/长对话追问时自动切换（多模型分级路由）
LLM_STRONG_MODEL=deepseek-reasoner
# 知识库未命中时用 LLM 通用知识兜底回答（默认 true，回答带免责标注；设 false 关闭）
LLM_FALLBACK=true

# ========================================
# 重排序参数
# ========================================
# 保留的最低相关度等级：2=直接相关、1=弱相关、0=无关（默认 1）
RERANK_MIN_LEVEL=1

# ========================================
# 搜索参数
# ========================================
# 向量相似度阈值（低于此值的结果不返回）
SIMILARITY_THRESHOLD=0.5
# 默认返回段落数
DEFAULT_LIMIT=5

# ========================================
# 上传限制
# ========================================
# 单文件大小上限（MB）：支持几千页大书（文字版 PDF/TXT/MD 通常几十 MB）；
# 扫描版 PDF 无文字层不支持（解析时会明确提示）
MAX_UPLOAD_MB=200
