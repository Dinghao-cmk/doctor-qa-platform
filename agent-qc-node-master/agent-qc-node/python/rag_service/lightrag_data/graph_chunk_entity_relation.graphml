  <data key="d12">1784273932</data>
  <data key="d13"></data>
</edge>
<edge source="高血压" target="继发性高血压">
  <data key="d7">2.0</data>
  <data key="d8">继发性高血压是高血压的一种类型，需通过特定指征进行筛查。&lt;SEP&gt;继发性高血压是高血压的一种类型，需筛查特定指征。</data>
